{
  "manifest_version": 3,
  "name": "Hide My Email",
  "description": "Shares your iCloud.com sign-in with the Hide My Email app.",
  "version": "1.0",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Hide My Email",
    "default_icon": "icon-48.png"
  },
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "permissions": ["cookies", "nativeMessaging"],
  "host_permissions": ["https://*.icloud.com/*", "https://*.icloud.com.cn/*"]
}
